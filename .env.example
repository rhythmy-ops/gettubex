# Development-only network settings. Keep real credentials out of Git.
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
ALL_PROXY=socks5://127.0.0.1:7890
NO_PROXY=127.0.0.1,localhost

# Compile-time fixed public GitHub repository used by the update checker.
# Export this before `npm run tauri dev`; do not accept it from task input.
GETTUBE_UPDATE_REPO=owner/gettube
